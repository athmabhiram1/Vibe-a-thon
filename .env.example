HR_BASE_URL=http://localhost:8001
IT_BASE_URL=http://localhost:8002
# Per-runner forward target — set to HR or IT value per Synapse runner invocation.
# hr-api runner: ENDPOINT_BASE_URL=http://localhost:8001
# it-api runner: ENDPOINT_BASE_URL=http://localhost:8002
ENDPOINT_BASE_URL=http://localhost:8001
# Golden path = SQLite files (WAL). Postgres is opt-in backup only (compose.opt.yml).
# Each service reads its own file-path var (code: hr_service/db.py HR_DB_PATH,
# it_service/db.py IT_DB_PATH), both defaulting to seed/demo.db.
# NOTE: DATABASE_URL is NOT read by code (grep hr_service/ it_service/ to confirm)
# — set HR_DB_PATH / IT_DB_PATH instead.
HR_DB_PATH=seed/demo.db
IT_DB_PATH=seed/demo.db
# Synapse server IDs (frozen): hr-api (H1-H5), it-api (I1-I6). Second build needs --new once.
SYNAPSE_SERVER_ID=hr-api
# Cursor hot-reload cache-bust: bump 1 -> 2 live after `synapse build --discover` (H5 get_oncall).
MCP_REV=1
# Local model replica (P2 fallback only). Golden path needs no model (stub default).
OLLAMA_HOST=http://localhost:11434
# Demo seed guard: seed/reset endpoints require true + header `x-demo-confirm: yes` + 6/min/IP.
ALLOW_DEMO_SEED=true
